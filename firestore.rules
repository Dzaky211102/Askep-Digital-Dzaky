rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connection test doc (used during startup verification)
    match /test/{testId} {
      allow read, write: if true;
    }

    // Allowed NIMs collection (Allowlist of official nursing students)
    match /allowed_nims/{nim} {
      allow get, write: if isValidId(nim);
      allow list: if true;
    }

    // Users collection
    match /users/{userId} {
      allow get, write: if isValidId(userId);
      allow list: if true;
    }

    // Patients collection - Always synced to cloud across devices
    match /patients/{patientId} {
      allow get, write: if isValidId(patientId);
      allow list: if true;
    }

    // CarePlans collection - Always synced to cloud across devices
    match /carePlans/{carePlanId} {
      allow get, write: if isValidId(carePlanId);
      allow list: if true;
    }
  }
}
